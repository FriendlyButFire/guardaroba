#!/bin/sh
# Personal data: block staged lines with this machine's user path or any extended regex
# listed in .git/info/private-patterns (local, never committed).
root=$(git rev-parse --show-toplevel)
patterns="Users[/\]+$(whoami)"
[ -f "$root/.git/info/private-patterns" ] && patterns="$patterns|$(grep -v '^$' "$root/.git/info/private-patterns" | paste -sd'|')"
if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -qiE "$patterns"; then
  echo "pre-commit: staged changes contain personal data (user path or a private pattern):"
  git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -iE "$patterns" | head -5
  exit 1
fi

# Unit tests before every commit that touches code or build files (docs-only commits skip them).
# Enabled per clone with: git config core.hooksPath .githooks
git diff --cached --name-only | grep -qE '\.(kt|kts|gradle|toml|properties|xml|zip)$|guardaroba\.json$' || exit 0
# The global JAVA_HOME is JDK 8; the build needs the JBR (JDK 21), see build-notes/android-env.md.
export JAVA_HOME="/c/Program Files/Android/Android Studio/jbr"
echo "pre-commit: ./gradlew :motore:test testDebugUnitTest"
./gradlew -q :motore:test testDebugUnitTest || { echo "pre-commit: tests failed, commit blocked"; exit 1; }
