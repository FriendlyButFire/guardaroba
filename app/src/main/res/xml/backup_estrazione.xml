<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automatico e trasferimento tra telefoni da Android 12: stesse regole di backup_regole.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="foto/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="foto/" />
    </device-transfer>
</data-extraction-rules>
